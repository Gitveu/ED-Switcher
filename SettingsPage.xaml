<Page
    x:Class="EDAccountSwitcher.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:EDAccountSwitcher.Localization"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="24" MaxWidth="800" HorizontalAlignment="Left">

            <TextBlock Text="{loc:Loc Key=Settings_Title}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12"/>

            <InfoBar x:Name="SaveErrorBar" IsOpen="False" Visibility="Collapsed" Severity="Error" Closed="InfoBar_Closed"/>

            <!-- Appearance & Behavior -->
            <StackPanel Spacing="12">
                <TextBlock Text="{loc:Loc Key=Settings_AppearanceSection}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="16">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Settings_Theme}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{loc:Loc Key=Settings_ThemeDesc}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <RadioButtons x:Name="ThemeRadioButtons" SelectionChanged="ThemeRadioButtons_SelectionChanged">
                            <RadioButton Content="{loc:Loc Key=Settings_ThemeLight}" Tag="Light"/>
                            <RadioButton Content="{loc:Loc Key=Settings_ThemeDark}" Tag="Dark"/>
                            <RadioButton Content="{loc:Loc Key=Settings_ThemeSystem}" Tag="Default"/>
                        </RadioButtons>

                        <MenuFlyoutSeparator Margin="-16,8, -16, 8"/>

                        <!-- Language -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Key=Settings_Language}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{loc:Loc Key=Settings_LanguageDesc}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="LanguageComboBox" Grid.Column="1"
                                  MinWidth="200" VerticalAlignment="Center"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="SystemLanguageItem" Tag="System"/>
                                <ComboBoxItem Content="{loc:Loc Key=Settings_LanguageEnglish}" Tag="en"/>
                                <ComboBoxItem Content="{loc:Loc Key=Settings_LanguageRussian}" Tag="ru"/>
                                <ComboBoxItem Content="{loc:Loc Key=Settings_LanguageBelarusian}" Tag="be"/>
                            </ComboBox>
                        </Grid>

                        <MenuFlyoutSeparator Margin="-16,8, -16, 8"/>

                        <!-- Game Language -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Key=Settings_GameLanguage}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{loc:Loc Key=Settings_GameLanguageDesc}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="GameLanguageComboBox" Grid.Column="1"
                                  MinWidth="200" VerticalAlignment="Center"
                                  SelectionChanged="GameLanguageComboBox_SelectionChanged"/>
                        </Grid>

                        <MenuFlyoutSeparator Margin="-16,8, -16, 8"/>

                        <!-- Interface sounds -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Settings_Sounds}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{loc:Loc Key=Settings_SoundsDesc}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="SoundToggle" Grid.Column="1"
                                      OffContent="{loc:Loc Key=Settings_Off}" OnContent="{loc:Loc Key=Settings_On}"
                                      Toggled="SoundToggle_Toggled"/>
                        </Grid>

                        <MenuFlyoutSeparator Margin="-16,8, -16, 8"/>

                        <!-- Auto Exit -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Key=Settings_AutoExit}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{loc:Loc Key=Settings_AutoExitDesc}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoExitToggle" Grid.Column="1"
                                      OffContent="{loc:Loc Key=Settings_Off}" OnContent="{loc:Loc Key=Settings_On}"
                                      Toggled="AutoExitToggle_Toggled"/>
                        </Grid>

                        <StackPanel x:Name="AutoExitDelayPanel" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="{loc:Loc Key=Settings_ExitDelay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{loc:Loc Key=Settings_ExitDelayDesc}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <NumberBox x:Name="AutoExitDelayBox"
                                   Minimum="0" Maximum="60" SmallChange="1" LargeChange="5"
                                   SpinButtonPlacementMode="Compact"
                                   Width="140" HorizontalAlignment="Left"
                                   ValueChanged="AutoExitDelayBox_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Privacy -->
            <StackPanel Spacing="12">
                <TextBlock Text="{loc:Loc Key=Settings_PrivacySection}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Settings_HideEmails}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{loc:Loc Key=Settings_HideEmailsDesc}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="HideEmailToggle" Grid.Column="1"
                                      OffContent="{loc:Loc Key=Settings_Off}" OnContent="{loc:Loc Key=Settings_On}"
                                      Toggled="HideEmailToggle_Toggled"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Game Directories -->
            <StackPanel Spacing="12">
                <TextBlock Text="{loc:Loc Key=Settings_DirectoriesSection}" Style="{StaticResource SubtitleTextBlockStyle}"/>

                <InfoBar x:Name="PathErrorBar" IsOpen="False" Visibility="Collapsed" Severity="Error"
                         Title="{loc:Loc Key=Settings_InvalidPathTitle}"
                         Message="{loc:Loc Key=Settings_InvalidPathMessage}"
                         Closed="InfoBar_Closed"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Key=Settings_InstallPath}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBox x:Name="InstallPathBox" Margin="0,8,0,0" TextChanged="InstallPathBox_TextChanged" Width="400"/>
                            </StackPanel>
                            <Button Content="{loc:Loc Key=Settings_Browse}" Grid.Column="1" VerticalAlignment="Bottom" Click="BrowseInstallPath_Click"/>
                        </Grid>

                        <MenuFlyoutSeparator Margin="-16,8, -16, 8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Key=Settings_LauncherPath}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBox x:Name="LauncherPathBox" Margin="0,8,0,0" TextChanged="LauncherPathBox_TextChanged" Width="400"/>
                            </StackPanel>
                            <Button Content="{loc:Loc Key=Settings_Browse}" Grid.Column="1" VerticalAlignment="Bottom" Click="BrowseLauncherPath_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <InfoBar x:Name="SaveSuccessBar" IsOpen="False" Visibility="Collapsed" Severity="Success"
                         Message="{loc:Loc Key=Settings_DirectoriesSaved}"
                         Closed="InfoBar_Closed"/>

                <Button x:Name="SavePathsButton" Content="{loc:Loc Key=Settings_SaveDirectories}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="SaveButton_Click"/>
            </StackPanel>

            <!-- About -->
            <StackPanel Spacing="8" Margin="0,16,0,0">
                <TextBlock Text="{loc:Loc Key=Settings_AboutSection}" FontWeight="SemiBold"/>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="AboutVersionText" Text="ED Account Switcher" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Copyright © 2026 Cybertveu. All rights XDDDD." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <HyperlinkButton Content="{loc:Loc Key=Settings_GitHubRepo}" NavigateUri="https://github.com/Gitveu/ED-Switcher" Margin="-12,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Updates -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Key=Settings_AppVersion}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateVersionText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <FontIcon x:Name="UpdateOkIcon" FontSize="12" Glyph="&#xE73E;"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                      Visibility="Collapsed"/>
                            <FontIcon x:Name="UpdateAvailableIcon" FontSize="12" Glyph="&#xE896;"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Visibility="Collapsed"/>
                            <FontIcon x:Name="UpdateFailedIcon" FontSize="12" Glyph="&#xE783;"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                      Visibility="Collapsed"/>
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="CheckUpdatesButton" Click="CheckUpdatesButton_Click"
                            VerticalAlignment="Center" Width="36" Height="36" Padding="0"
                            CornerRadius="18" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <InfoBar x:Name="UpdateInfoBar" IsOpen="False" Visibility="Collapsed"
                     IsClosable="True" Closed="InfoBar_Closed"/>
        </StackPanel>
    </ScrollViewer>
</Page>