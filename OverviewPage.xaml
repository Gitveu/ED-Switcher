<Page
    x:Class="EDAccountSwitcher.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="24" Padding="0,0,0,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="16">
                <TextBlock Text="Accounts Overview" Style="{ThemeResource TitleTextBlockStyle}" />

                <ListView x:Name="AccountsListView" 
                          SelectionMode="Single"
                          CornerRadius="8"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                          Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="12" Background="Transparent">
                                <StackPanel.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Delete Account" 
                                                        Icon="Delete" 
                                                        Click="DeleteAccount_Click"
                                                        DataContext="{Binding}"/>
                                    </MenuFlyout>
                                </StackPanel.ContextFlyout>

                                <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="{Binding Email}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Bottom" Margin="0,40,0,0">
                <TextBlock Text="Commander Tools" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <HyperlinkButton Grid.Row="0" Grid.Column="0" Content="INARA" NavigateUri="https://inara.cz/" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"/>
                    <HyperlinkButton Grid.Row="0" Grid.Column="1" Content="EDSM" NavigateUri="https://www.edsm.net/" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"/>
                    <HyperlinkButton Grid.Row="1" Grid.Column="0" Content="Spansh (Neutron Router)" NavigateUri="https://spansh.co.uk/" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"/>
                    <HyperlinkButton Grid.Row="1" Grid.Column="1" Content="EDSY (Ship Builds)" NavigateUri="https://edsy.org/" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"/>
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="16" 
                        Spacing="12"
                        CornerRadius="8" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">

                <TextBlock Text="Launch Options" FontWeight="SemiBold" />

                <ComboBox x:Name="ProductComboBox" 
                          HorizontalAlignment="Stretch" 
                          PlaceholderText="Select Installed Product"
                          DisplayMemberPath="Name" />

                <CheckBox x:Name="VrModeCheckBox" Content="Launch in VR Mode" />

                <Button x:Name="LaunchButton" 
                        Content="Launch Game" 
                        Style="{ThemeResource AccentButtonStyle}" 
                        HorizontalAlignment="Stretch"
                        Click="LaunchButton_Click"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,16,0,0"
                  CornerRadius="8"
                  Background="#0A0A0A"
                  BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                  BorderThickness="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Console Output" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button Click="CopyConsole_Click" Padding="6" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Copy to Clipboard">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="White"/>
                        </Button>
                        <Button Click="SaveConsole_Click" Padding="6" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Save to File">
                            <FontIcon Glyph="&#xE792;" FontSize="14" Foreground="White"/>
                        </Button>
                        <Button Click="ClearConsole_Click" Padding="6" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Clear Console">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogTextBlock" 
                               FontFamily="Cascadia Code, Consolas" 
                               Foreground="#10B981" 
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>