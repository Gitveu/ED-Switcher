<Page
    x:Class="EDAccountSwitcher.AddAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:EDAccountSwitcher.Localization"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16" MaxWidth="500" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Key=AddAccount_Title}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12"/>

            <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,16"/>

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Key=AddAccount_ProfileName}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBox x:Name="ProfileBox"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Key=AddAccount_Email}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBox x:Name="EmailBox"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Key=AddAccount_Password}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <PasswordBox x:Name="PasswordBox"/>
            </StackPanel>

            <StackPanel x:Name="TwoFactorPanel" Spacing="4" Visibility="Collapsed">
                <TextBlock Text="{loc:Loc Key=AddAccount_TwoFactor}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBox x:Name="TwoFactorBox"/>
            </StackPanel>

            <Button x:Name="AuthButton" Content="{loc:Loc Key=AddAccount_AuthButton}" Style="{StaticResource AccentButtonStyle}" 
                    HorizontalAlignment="Stretch" Click="AuthButton_Click" Margin="0,16,0,0"/>

            <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>